# Datadog — at least one site's credentials required
DD_US_API_KEY=
DD_US_APP_KEY=
# DD_EU_API_KEY=
# DD_EU_APP_KEY=

# Claude CLI
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
# Per-investigation dollar cap. Leave unset on a subscription plan.
CLAUDE_MAX_BUDGET=2.00

# Linear (optional — only needed if tracker type is "linear")
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=

# Notion (optional — only needed if doc_sink type is "notion")
# NOTION_API_KEY=
# NOTION_DATABASE_ID=

# Slack (optional — only needed if notifier type is "slack")
# SLACK_WEBHOOK_URL=
# SLACK_CHANNEL_ID=

# Dashboard
DASHBOARD_PORT=8111

# Tuning
NITPICK_INTERVAL=1800
NITPICK_LOOKBACK=3600
NITPICK_MAX_ERRORS_PER_RUN=10
NITPICK_MAX_INVESTIGATIONS_PER_DAY=50
NITPICK_DRY_RUN=false
